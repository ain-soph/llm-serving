<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.local.llm-gateway</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/caddy</string><string>run</string>
		<string>--config</string><string>@SERVING_ROOT@/platform/gateway/Caddyfile</string>
		<string>--adapter</string><string>caddyfile</string>
		<string>--envfile</string><string>@SERVING_ROOT@/.local/serving.env</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>XDG_DATA_HOME</key><string>@SERVING_ROOT@/platform/gateway/data</string>
		<key>XDG_CONFIG_HOME</key><string>@SERVING_ROOT@/platform/gateway/data</string>
	</dict>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>StandardOutPath</key><string>@SERVING_ROOT@/platform/gateway/logs/stdout.log</string>
	<key>StandardErrorPath</key><string>@SERVING_ROOT@/platform/gateway/logs/stderr.log</string>
</dict>
</plist>

;; Outer macOS sandbox for every local-worker run (both harnesses, and every command they start).
;; Network: only the local API port (llama-swap gateway) and the run's deny-proxy (which logs and refuses
;; everything) on localhost; unix sockets for local IPC. Everything else outbound is refused by the kernel.
;; Files: writes only inside the task directory, the harness's own config/state dir, the run's log dir
;; (which holds TMPDIR) and /dev. Reads are not restricted.
(version 1)
(allow default)
(deny network-outbound)
(allow network-outbound (remote unix-socket))
(allow network-outbound (remote ip (string-append "localhost:" (param "API_PORT"))))
(allow network-outbound (remote ip (string-append "localhost:" (param "PROXY_PORT"))))
(deny file-write*)
(allow file-write*
  (subpath (param "WORK"))
  (subpath (param "HARNESS_HOME"))
  (subpath (param "RUN_DIR"))
  (subpath "/dev"))

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.local.health</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string><string>@SERVING_ROOT@/bin/health-check</string>
	</array>
	<key>StartInterval</key><integer>600</integer>
	<key>RunAtLoad</key><true/>
	<key>StandardOutPath</key><string>@SERVING_ROOT@/logs/health/launchd.out</string>
	<key>StandardErrorPath</key><string>@SERVING_ROOT@/logs/health/launchd.err</string>
</dict>
</plist>

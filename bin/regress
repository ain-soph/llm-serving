import signal
import struct
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

import numpy as np
from PIL import Image

ROOT = Path(__file__).resolve().parents[1]
GOLDEN = Path(os.environ.get("LLM_GOLDEN_DIR") or ROOT / "evals" / "golden")
LOGS = ROOT / "logs" / "regress"
GATEWAY = os.environ.get("LLM_GATEWAY", "http://127.0.0.1:8080")
KEY_FILE = ROOT / "platform" / "llama-swap" / ".api_key"
KEY = KEY_FILE.read_text().strip() if KEY_FILE.is_file() else ""
GPU_LOCK = ROOT / "bin" / "gpu-lock"
ASR = GOLDEN / "inputs"   # copies of two asr/eval clips, so the reorg cannot break them
LSW = ROOT / "platform" / "llama-swap"
ARCHIVE_RESTORE = ROOT / "bin" / "archive-restore"


# ---------------------------------------------------------------- archived entries (2026-11-23)


def _archive_restore():
    """bin/archive-restore as a module, so the archived / complete decision is its own code, not a second copy."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    loader = SourceFileLoader("archive_restore", str(ARCHIVE_RESTORE))
    spec = importlib.util.spec_from_loader("archive_restore", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


_AR, _ENTRY_DIRS, _DIR_STATE = None, None, {}


def entry_dirs():
    """llama-swap model id (and alias) -> the ~/models directories its cmd hands to bin/archive-restore."""
    global _AR, _ENTRY_DIRS
    if _ENTRY_DIRS is None:
        import yaml
        _AR = _AR or _archive_restore()
        _ENTRY_DIRS = {}
        for f in [LSW / "config.yaml", *sorted((LSW / "conf.d").glob("*.yaml"))]:
            for mid, m in ((yaml.safe_load(f.read_text()) or {}).get("models") or {}).items():
                argv = shlex.split(str((m or {}).get("cmd", "")).replace("${PORT}", "0"))
                at = [i for i, x in enumerate(argv) if Path(x).name == "archive-restore"]
                if not at:
                    continue
                args = argv[at[0] + 1:]
                if "--" in args:
                    args = args[:args.index("--") + 1]   # archive-restore's own options only (parse needs no command)
                _, _, dirs, _ = _AR.parse(args)
                for name in [mid, *((m or {}).get("aliases") or [])]:
                    _ENTRY_DIRS[name] = dirs
    return _ENTRY_DIRS


def dir_archived(name):
    """None if usable; else why: archived (~/models/<name>.archive) and the local copy is missing or incomplete."""
    if name not in _DIR_STATE:
        ar = _AR or _archive_restore()
        local, shortcut = ar.MODELS / name, ar.MODELS / f"{name}.archive"
        why = None
        if shortcut.is_file():
            if not os.path.lexists(local):
                why = "missing"
            else:
                bad = ar.problems(local, ar.load_manifest(shortcut)[2])
                why = f"incomplete ({len(bad)}: {', '.join(bad[:2])})" if bad else None
        _DIR_STATE[name] = why
    return _DIR_STATE[name]


def archived(model):
    """['dir (missing)', ...] for an entry whose weights are archived and not usable here; [] otherwise."""
    out = []
    for d in entry_dirs().get(model, []):
        why = dir_archived(d)
        if why:
            out.append(f"{d} ({why})")
    return out

DECIDE = {"state": "My integration keeps failing with a 401 since we rotated our API key. Please help.",
          "questions": {"team": {"type": "choice", "instructions": "Which team should handle this request?",
                                 "criteria": {"billing": "Charges and refunds",
                                              "support": "Technical integration errors",
                                              "sales": "Questions about buying a product"}},
                        "urgent": {"type": "noul", "instructions": "Is the customer blocked right now?"},
                        "refund": {"type": "noul", "instructions": "Is the customer asking for a refund?"}}}
DECIDE2 = {"state": "Invoice #4411: 2 x USB-C cable, $19.98, paid by card on 2026-11-02. Thank you for your order.",
           "questions": {"invoice": {"type": "noul", "instructions": "Is the document an invoice?"},
                         "paid": {"type": "noul", "instructions": "Has the invoice been paid?"}}}
DOCS = ["Paris is the capital and largest city of France.", "Berlin is the capital of Germany.",
        "The Eiffel Tower is in Paris.", "Bananas are rich in potassium.", "Lyon is a city in France."]
EMBED_IN = ["regression test sentence one", "第二句测试：服务回归检查", "The quick brown fox jumps over the lazy dog."]
EN_WAV, EN_REF = "en/1089-134691-0015.wav", "WORDS WAS IT THEIR COLOURS"
ZH_WAV = "zh/aishell_00050.wav"


def decide_image():
    """A decision about a generated image (blue square on white, PNG data URL): the vision path of pplx-decider-flash."""
    img = Image.new("RGB", (640, 480), "white")
    img.paste((30, 60, 220), (200, 120, 440, 360))
    buf = io.BytesIO()
    img.save(buf, "PNG")
    return {"state": "A product photo.", "images": ["data:image/png;base64," + base64.b64encode(buf.getvalue()).decode()],
            "questions": {"shape": {"type": "choice", "instructions": "Which shape is shown?",
                                    "criteria": {"circle": None, "square": None, "triangle": None}},
                          "color": {"type": "choice", "instructions": "What is the colour of the main shape?",
                                    "criteria": {"red": None, "green": None, "blue": None}}}}


def control_map():
    """A canny-style edge map (white lines on black, 768x768, drawn here so no third-party image is stored): a house
    with a door, a window and a tree, for the qwen-image ControlNet case."""
    from PIL import ImageDraw
    img = Image.new("RGB", (768, 768), "black")
    d = ImageDraw.Draw(img)
    for box in ((160, 360, 520, 680), (300, 520, 380, 680), (400, 430, 480, 500), (590, 560, 620, 680)):
        d.rectangle(box, outline="white", width=3)
    d.line((140, 370, 340, 200, 540, 370), fill="white", width=3)
    d.ellipse((530, 400, 680, 570), outline="white", width=3)
    d.line((60, 680, 720, 680), fill="white", width=3)
    buf = io.BytesIO()
    img.save(buf, "PNG")
    return "data:image/png;base64," + base64.b64encode(buf.getvalue()).decode()


TIMED = ("chat", "embed", "rerank", "decide", "asr")   # cheap enough to send twice and time the warm request
SLOWER, SLOWER_MIN_S = 1.3, 0.2


def strata_image():
    """The Flash-Next vision cases' picture as a data URL (read when the cases are built)."""
    return "data:image/png;base64," + base64.b64encode((ASR / "strata-vision.png").read_bytes()).decode()


def case(cid, kind, model, body, quick=True, order=1, **extra):
    return {"id": cid, "kind": kind, "model": model, "body": body, "quick": quick, "order": order,
            "timed": kind in TIMED, **extra}


LONG_LOG = "2026-11-16 INFO request served in 21 ms. "   # ~20 tokens: x 1600 ~ 32K tokens


def decide_long(tokens):
    """The Decider's 11-17 long-input case (32,585 tokens at 1625 lines) / an elephant-size one (16K)."""
    return {"state": LONG_LOG * tokens + "2026-11-16 ERROR db connection refused.",
            "questions": {"err": {"type": "noul", "instructions": "Does the log contain an error?"}}}


def cases():
    out = []
    chat = {"messages": [{"role": "user", "content": "In one short sentence: what is the capital of France?"}],
            "temperature": 0, "seed": 1, "max_tokens": 64}
    for m in ("qwen3.8-flash-next", "qwen3.8-flash-next-uncensored"):
        order = 0 if m == "qwen3.8-flash-next" else 2
        # 64 tokens can end inside the thinking part (the compared text is then the reasoning alone); the full mode
        # adds a request long enough to reach the answer
        out.append(case(f"chat-{m}", "chat", m, chat, order=order))
        out.append(case(f"chatlong-{m}", "chat", m, {**chat, "max_tokens": 1024}, quick=False, order=order))
        # vision (2026-11-22): the picture path (evals/golden/inputs/strata-vision.png = services/text/strata/bench/test.png:
        # the number 7391 and a red circle), temperature 0, thinking off; the description depends on the vision tower
        for vid, q, n, quick in (("vision", "What number is written in the image, and what color is the circle?", 40, True),
                                 ("visiondesc", "Describe this image in two sentences.", 80, False)):
            vis = {"messages": [{"role": "user", "content": [{"type": "text", "text": q},
                                                             {"type": "image_url", "image_url": {"url": strata_image()}}]}],
                   "temperature": 0, "seed": 1, "max_tokens": n, "chat_template_kwargs": {"enable_thinking": False}}
            out.append(case(f"{vid}-{m}", "chat", m, vis, quick=quick, order=order))
    # Hy4-Flash (2026-11-23, on-demand backup entry; unloads Flash-Next, so order 3): thinking off through the template's
    # reasoning_effort (Hy4 knows no_think / high), temperature 0; the full mode adds the thinking path and the picture
    hy4 = {**chat, "chat_template_kwargs": {"reasoning_effort": "no_think"}}
    out.append(case("chat-hy4-flash", "chat", "hy4-flash", hy4, order=3))
    out.append(case("chatlong-hy4-flash", "chat", "hy4-flash", {**chat, "max_tokens": 1024}, quick=False, order=3))
    out.append(case("vision-hy4-flash", "chat", "hy4-flash",
                    {"messages": [{"role": "user", "content": [
                        {"type": "text", "text": "What number is written in the image, and what color is the circle?"},
                        {"type": "image_url", "image_url": {"url": strata_image()}}]}],
                     "temperature": 0, "seed": 1, "max_tokens": 40,
                     "chat_template_kwargs": {"reasoning_effort": "no_think"}}, quick=False, order=3))
    for m in ("embeddinggemma-2", "embeddinggemma-2-multimodal", "qwen3-embedding-0.6b", "qwen3-embedding-4b",
              "qwen3-embedding-8b", "voyage-4-nano"):
        out.append(case(f"embed-{m}", "embed", m, {"input": EMBED_IN}, order=0 if m == "embeddinggemma-2" else 1))
        if m.startswith(("qwen3-", "voyage")):   # one 32K-token input (the context limit): speed and long-input memory
            out.append(case(f"embedlong-{m}", "embed", m, {"input": [LONG_LOG * 1640]}, quick=False))
    for m in ("qwen3-reranker-0.6b", "qwen3-reranker-4b", "qwen3-reranker-8b"):
        out.append(case(f"rerank-{m}", "rerank", m, {"query": "What is the capital of France?", "documents": DOCS}))
        out.append(case(f"reranklong-{m}", "rerank", m, {"query": "Which request failed?",
                                                          "documents": [LONG_LOG * 1600]}, quick=False))
    for m, order in (("pplx-decider-flash", 1), ("elephant-1", 1), ("joey-1", 1), ("drex-v1.5", 1), ("mammoth-1", 3)):
        out.append(case(f"decide-{m}", "decide", m, DECIDE, order=order))
        out.append(case(f"decide2-{m}", "decide", m, DECIDE2, quick=False, order=order))
    out.append(case("decide-img-pplx-decider-flash", "decide", "pplx-decider-flash", decide_image(), quick=False))
    out.append(case("decide-long-pplx-decider-flash", "decide", "pplx-decider-flash", decide_long(1625), quick=False))
    out.append(case("decide-long-elephant-1", "decide", "elephant-1", decide_long(780), quick=False))
    for m, order in (("qwen3-asr-1.7b", 1), ("whisper-large-v3", 1)):
        out.append(case(f"asr-{m}", "asr", m, {"file": EN_WAV}, order=order))
        out.append(case(f"asrzh-{m}", "asr", m, {"file": ZH_WAV, "language": "zh"}, quick=False, order=order))
    tts = {"input": "Regression check: the quick brown fox jumps over the lazy dog.", "response_format": "wav",
           "seed": 7, "temperature": 0}
    # preset and design voices: seeded sampling, not temperature 0. Greedy decoding degenerated on this sentence (ran
    # to the 34 s frame cap after "Regression check." when first recorded 2026-11-17), as the official model can
    # (reports/tts.md). The clone and CosyVoice cases decode it correctly with temperature 0 and keep it.
    sampled = {k: v for k, v in tts.items() if k != "temperature"}
    out.append(case("tts-qwen3-tts", "tts", "qwen3-tts", {**sampled, "voice": "alloy"}))
    out.append(case("tts-qwen3-tts-design", "tts", "qwen3-tts-design",
                    {**sampled, "instructions": "A calm middle-aged male narrator with a warm, low voice."}))
    out.append(case("tts-qwen3-tts-clone", "tts", "qwen3-tts-clone",
                    {**tts, "ref_file": EN_WAV, "ref_text": EN_REF.capitalize() + "?"}))
    # cosyvoice3 is being retired (2026-11-17, Qwen3-TTS covers the dialects): once it leaves /v1/models this case is
    # SKIPped; its golden output is kept (evals/golden/tts-cosyvoice3/NOTE) in case the entry comes back.
    # Fish Audio Drama 3 (2026-11-23): exclusive entry (unloads Flash-Next), seeded sampling, built-in en voice
    out.append(case("tts-fish-drama-3", "tts", "fish-drama-3", {**sampled, "voice": "en"}, order=3))
    out.append(case("tts-cosyvoice3", "tts", "cosyvoice3", {**tts, "voice": "zh", "input": "回归检查：今天天气很好。"}))
    img = {"prompt": "A red apple on a wooden table, soft daylight", "size": "512x512", "seed": 11}
    out.append(case("image-qwen-image-2.1-turbo", "image", "qwen-image-2.1-turbo", img, order=1))
    out.append(case("image-qwen-image-2.1", "image", "qwen-image-2.1", img, order=1))
    # per-request LoRA (2026-11-23): the registered voxel adapter; same request as the T4 check
    # (services/backlog-t4-20261123/lora/lora_http.py gen-voxel), so the golden equals that direct-server output
    out.append(case("imagelora-qwen-image-2.1-turbo", "image", "qwen-image-2.1-turbo",
                    {"prompt": "A red vintage car parked in front of a small bakery on a sunny street, photo",
                     "size": "768x768", "seed": 7, "lora": "voxel"}, quick=False, order=1))
    # per-request ControlNet (2026-11-24): a drawn edge map steers the layout (services/image/qwen-image/controlnet-20261124)
    out.append(case("imagecnet-qwen-image-2.1-turbo", "image", "qwen-image-2.1-turbo",
                    {"prompt": "A small red brick house with a wooden door and a tree beside it, sunny day, photo",
                     "seed": 7, "control_image": control_map()}, quick=False, order=1))
    out.append(case("image1024-qwen-image-2.1-turbo", "image", "qwen-image-2.1-turbo", {**img, "size": "1024x1024"},
                    quick=False, order=1))
    out.append(case("smoke-qwen-image-2.1-turbo-pe", "smoke", "qwen-image-2.1-turbo-pe", img, order=1,
                    path="/v1/images/generations", expect="revised_prompt",
                    needs=["qwen3.8-flash-next"]))   # the prompt is rewritten by the chat model
    out.append(case("image-minimax-h3-image", "image", "minimax-h3-image", img, order=1))
    # official PE (2026-11-23): the expansion samples (T 1.0), so only success, revised_prompt and the size are checked;
    # it unloads Flash-Next (order 3: after the cases that run beside it)
    out.append(case("smoke-minimax-h3-image-pe", "smoke", "minimax-h3-image-pe", img, order=3,
                    path="/v1/images/generations", expect="revised_prompt", image_size=(512, 512)))
    out.append(case("image-z-image-turbo", "image", "z-image-turbo", img, order=1))
    out.append(case("image1024-z-image-turbo", "image", "z-image-turbo", {**img, "size": "1024x1024"},
                    quick=False, order=1))
    vid = {"prompt": "A paper boat drifting on a calm pond, gentle ripples", "size": "512x512", "seconds": 1,
           "seed": 42, "response_format": "mp4"}
    out.append(case("video-minimax-h3-video", "video", "minimax-h3-video", vid, order=4))
    out.append(case("videofast-minimax-h3-video", "video", "minimax-h3-video", {**vid, "preset": "fast"},
                    quick=False, order=4))
    out.append(case("videoturbo-minimax-h3-video", "video", "minimax-h3-video", {**vid, "preset": "turbo"},
                    quick=False, order=4))
    # Ref2VA (2026-11-22): a reference picture (evals/golden/inputs/h3-ref-fox.png = services/video/h3-video/bench/cc/
    # inputs/first-fox.png) runs the separate Ref2VA DiT (Ref2VA/transformer-int8). The API refused every reference
    # request (stale has_ref2va check) and no case noticed. Same request as the fork-cleanup CLI A/B (refimg, 512x288,
    # 56 frames, seed 42, standard): golden md5 01fb991b... there.
    ref = {"prompt": "The fox from <Picture 1> walks slowly through a snowy forest at dawn, soft wind, crunching snow",
           "size": "512x288", "frames": 56, "seed": 42, "preset": "standard", "response_format": "mp4",
           "reference_images": ["data:image/png;base64," + base64.b64encode((ASR / "h3-ref-fox.png").read_bytes()).decode()]}
    out.append(case("videoref-minimax-h3-video", "video", "minimax-h3-video", ref, order=4))
    return out


# ---------------------------------------------------------------- HTTP


def post(path, body=None, files=None, timeout=1800):
    headers = {"Authorization": "Bearer " + KEY}
    if files is not None:
        boundary = "regress" + hashlib.md5(os.urandom(8)).hexdigest()
        parts = []
        for k, v in body.items():
            parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode())
        for k, (name, data) in files.items():
            parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"; filename=\"{name}\"\r\n"
                         f"Content-Type: application/octet-stream\r\n\r\n".encode() + data + b"\r\n")
        data = b"".join(parts) + f"--{boundary}--\r\n".encode()
        headers["Content-Type"] = f"multipart/form-data; boundary={boundary}"
    else:
        data = json.dumps(body).encode() if body is not None else None
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(GATEWAY + path, data=data, headers=headers, method="POST" if data else "GET")
    t = time.time()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, r.read(), time.time() - t
    except urllib.error.HTTPError as e:
        return e.code, e.read(), time.time() - t


def run_case(c):
    """Returns (output bytes or object, http code, seconds)."""
    b, m = dict(c["body"]), c["model"]
    k = c["kind"]
    if k == "chat":
        code, raw, dt = post("/v1/chat/completions", {"model": m, **b})
        if code != 200:
            return None, code, dt, raw
        msg = json.loads(raw)["choices"][0]["message"]
        return {"content": msg.get("content"), "reasoning": msg.get("reasoning_content")}, code, dt, raw
    if k == "embed":
        code, raw, dt = post("/v1/embeddings", {"model": m, **b})
        if code != 200:
            return None, code, dt, raw
        return [d["embedding"] for d in sorted(json.loads(raw)["data"], key=lambda d: d["index"])], code, dt, raw
    if k == "rerank":
        code, raw, dt = post("/v1/rerank", {"model": m, **b})
        if code != 200:
            return None, code, dt, raw
        res = json.loads(raw)["results"]
        return {r["index"]: r["relevance_score"] for r in res}, code, dt, raw
    if k == "decide":
        code, raw, dt = post("/v1/systemone", {"model": m, **b})
        if code != 200:
            return None, code, dt, raw
        return json.loads(raw)["answers"], code, dt, raw
    if k == "asr":
        f = ASR / b.pop("file")
        fields = {"model": m, "response_format": "json", "temperature": 0, **b}
        code, raw, dt = post("/v1/audio/transcriptions", fields, {"file": (f.name, f.read_bytes())})
        if code != 200:
            return None, code, dt, raw
        return json.loads(raw)["text"].strip(), code, dt, raw
    if k == "tts":
        if "ref_file" in b:
            b["ref_audio"] = base64.b64encode((ASR / b.pop("ref_file")).read_bytes()).decode()
        code, raw, dt = post("/v1/audio/speech", {"model": m, **b})
        return (raw if code == 200 else None), code, dt, raw
    if k in ("image", "smoke"):
        code, raw, dt = post(c.get("path", "/v1/images/generations"), {"model": m, **b})
        if code != 200:
            return None, code, dt, raw
        d = json.loads(raw)["data"][0]
        if k == "smoke":
            return d, code, dt, raw
        return base64.b64decode(d["b64_json"]), code, dt, raw
    if k == "video":
        code, raw, dt = post("/upstream/minimax-h3-video/v1/videos", {"model": m, **b}, timeout=3600)
        return (raw if code == 200 and raw[4:8] == b"ftyp" else None), code, dt, raw
    raise ValueError(k)


# ---------------------------------------------------------------- golden I/O and comparison


def save_golden(c, out):
    d = GOLDEN / c["id"]
    d.mkdir(parents=True, exist_ok=True)
    k = c["kind"]
    if k in ("tts", "video"):
        (d / ("golden.wav" if k == "tts" else "golden.mp4")).write_bytes(out)
        meta = {"md5": hashlib.md5(out).hexdigest()}
        if k == "tts":
            meta["seconds"] = wav_seconds(out)
            meta["asr"] = transcribe(out)
    elif k == "image":
        (d / "golden.png").write_bytes(out)
        meta = {"md5": hashlib.md5(out).hexdigest()}
    else:
        if k == "smoke":  # only checked for success and the expected field: do not store the image
            out = {key: v for key, v in out.items() if key != "b64_json"}
        (d / "golden.json").write_text(json.dumps(out, ensure_ascii=False))
        meta = {}
    meta.update({"model": c["model"], "kind": k, "request": c["body"], "recorded": time.strftime("%F %T")})
    (d / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=1))


def wav_seconds(data):
    """Duration from the bytes actually present: the TTS servers stream WAV with a placeholder length (0xFFFFFFFF)."""
    channels, rate = struct.unpack("<HI", data[22:28])
    bits = struct.unpack("<H", data[34:36])[0]
    start = data.find(b"data") + 8
    declared = struct.unpack("<I", data[start - 4:start])[0]
    size = min(declared, len(data) - start)
    return size / (rate * channels * bits // 8)


def transcribe(wav):
    if archived("qwen3-asr-1.7b"):   # never trigger a copy-back from the TTS comparison either
        return None
    code, raw, _ = post("/v1/audio/transcriptions", {"model": "qwen3-asr-1.7b", "response_format": "json"},
                        {"file": ("tts.wav", wav)})
    return json.loads(raw)["text"].strip() if code == 200 else None


def psnr(a, b):
    a = np.asarray(a, dtype=np.float64)
    b = np.asarray(b, dtype=np.float64)
    mse = np.mean((a - b) ** 2)
    return math.inf if mse == 0 else 10 * math.log10(255.0 ** 2 / mse)


def video_psnr(a, b):
    with tempfile.TemporaryDirectory() as t:
        pa, pb = Path(t, "a.mp4"), Path(t, "b.mp4")
        pa.write_bytes(a)
        pb.write_bytes(b)
        r = subprocess.run(["/opt/homebrew/bin/ffmpeg", "-hide_banner", "-i", str(pa), "-i", str(pb), "-lavfi", "psnr",
                            "-f", "null", "-"], capture_output=True, text=True)
        for line in r.stderr.splitlines()[::-1]:
            if "average:" in line:
                v = line.split("average:")[1].split()[0]
                return math.inf if v == "inf" else float(v)
    return 0.0


def probs(a):
    return [a["noul"], 1 - a["noul"]] if a.get("type") == "noul" else list(a["probabilities"].values())


def top(a):
    return "yes" if a.get("type") == "noul" and a["noul"] >= 0.5 else (
        "no" if a.get("type") == "noul" else max(a["probabilities"], key=a["probabilities"].get))


def timing(c, warm, status, detail):
    """Compare the warm time with meta.json "warm_seconds" (store it when missing and the outputs match)."""
    path = GOLDEN / c["id"] / "meta.json"
    meta = json.loads(path.read_text())
    g = meta.get("warm_seconds")
    if g is None:
        if status in ("PASS", "WARN", "RECORDED"):
            meta["warm_seconds"] = round(warm, 3)
            path.write_text(json.dumps(meta, ensure_ascii=False, indent=1))
            return status, (detail + "; " if detail else "") + f"timing baseline {warm:.2f}s stored"
        return status, detail
    if warm > SLOWER * g and warm - g >= SLOWER_MIN_S:
        return ("WARN" if status == "PASS" else status), f"{detail}; slower: warm {warm:.2f}s vs {g:.2f}s ({warm / g:.2f}x)"
    return status, f"{detail}; warm {warm:.2f}s ({g:.2f}s)"


def compare(c, out):
    d, k = GOLDEN / c["id"], c["kind"]
    meta = json.loads((d / "meta.json").read_text())
    if k == "chat":
        g = json.loads((d / "golden.json").read_text())
        return ("PASS", "identical") if g == out else ("FAIL", f"text differs: {str(out.get('content'))[:80]!r}")
    if k == "embed":
        g = np.array(json.loads((d / "golden.json").read_text()))
        o = np.array(out)
        if g.shape == o.shape and np.array_equal(g, o):
            return "PASS", "identical"
        if g.shape != o.shape:
            return "FAIL", f"shape {o.shape} vs {g.shape}"
        if np.abs(g - o).max() <= 1e-6:  # float rounding only (e.g. a different batch shape)
            return "PASS", f"max abs diff {np.abs(g - o).max():.1e}"
        cos = (g * o).sum(1) / np.linalg.norm(g, axis=1) / np.linalg.norm(o, axis=1)
        return ("WARN" if cos.min() >= 0.9999 else "FAIL"), f"min cosine {cos.min():.6f}"
    if k == "rerank":
        g = {int(i): v for i, v in json.loads((d / "golden.json").read_text()).items()}
        o = {int(i): v for i, v in out.items()}
        diff = max(abs(g[i] - o[i]) for i in g)
        if diff == 0:
            return "PASS", "identical"
        same = sorted(g, key=g.get) == sorted(o, key=o.get)
        return ("WARN" if same and diff <= 0.01 else "FAIL"), f"max diff {diff:.5f}, order {'same' if same else 'changed'}"
    if k == "decide":
        g = json.loads((d / "golden.json").read_text())
        dp = max(max(abs(x - y) for x, y in zip(probs(out[q]), probs(g[q]))) for q in g)
        if dp == 0:
            return "PASS", "identical"
        flips = [q for q in g if top(g[q]) != top(out[q])]
        return ("WARN" if dp <= 0.01 and not flips else "FAIL"), f"max |dp| {dp:.5f}" + (f", flipped {flips}" if flips else "")
    if k == "asr":
        g = json.loads((d / "golden.json").read_text())
        return ("PASS", "identical") if g == out else ("FAIL", f"{out[:60]!r} vs {g[:60]!r}")
    if k == "tts":
        if hashlib.md5(out).hexdigest() == meta["md5"]:
            return "PASS", "identical"
        s, text = wav_seconds(out), transcribe(out)
        ok = abs(s - meta["seconds"]) <= 0.1 * meta["seconds"] and text == meta["asr"]
        return ("WARN" if ok else "FAIL"), f"{s:.2f} s vs {meta['seconds']:.2f} s, asr {'same' if text == meta['asr'] else repr(text)}"
    if k == "image":
        if hashlib.md5(out).hexdigest() == meta["md5"]:
            return "PASS", "identical bytes"
        a, b = Image.open(io.BytesIO(out)).convert("RGB"), Image.open(d / "golden.png").convert("RGB")
        if a.size != b.size:
            return "FAIL", f"size {a.size} vs {b.size}"
        p = psnr(a, b)
        return ("PASS" if p == math.inf else "WARN" if p >= 40 else "FAIL"), f"PSNR {p:.1f} dB"
    if k == "video":
        if hashlib.md5(out).hexdigest() == meta["md5"]:
            return "PASS", "identical bytes"
        p = video_psnr(out, (d / "golden.mp4").read_bytes())
        return ("WARN" if p >= 40 else "FAIL"), f"PSNR {p:.1f} dB"
    if k == "smoke":
        if not out.get(c["expect"]):
            return "FAIL", f"missing {c['expect']}"
        if c.get("image_size"):
            size = Image.open(io.BytesIO(base64.b64decode(out["b64_json"]))).size
            if size != tuple(c["image_size"]):
                return "FAIL", f"size {size} vs {tuple(c['image_size'])}"
        return "PASS", "ok"
    raise ValueError(k)


# ---------------------------------------------------------------- lock


class Lock:
    def __init__(self):
        self.held = False
        # one lock name per run (2026-11-18): with a shared "regress" name a second run joined the first one's share,
        # and when the first released, the next queued holder paused llama-swap under the second run's video case
        self.name = f"regress.{os.getpid()}"

    def acquire(self):
        while True:
            rc = subprocess.run([str(GPU_LOCK), "acquire", self.name], capture_output=True, text=True).returncode
            if rc == 0:
                self.held = True
                break
            if rc != 1:
                sys.exit(f"gpu-lock acquire refused (exit {rc}); not retrying")
        # gpu-lock pauses llama-swap for its first holder; the regression goes through llama-swap like a client
        code, _, _ = post("/api/models/resume", {})
        print(f"gpu-lock '{self.name}' held; llama-swap resume: http {code}", flush=True)

    def release(self, *_):
        if self.held:
            subprocess.run([str(GPU_LOCK), "release", self.name], capture_output=True)
            self.held = False


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--record", action="store_true")
    ap.add_argument("--quick", action="store_true")
    ap.add_argument("--only")
    ap.add_argument("--no-lock", action="store_true")
    ap.add_argument("--list", action="store_true")
    a = ap.parse_args()

    todo = [c for c in cases() if a.record or not a.quick or c["quick"]]
    if a.only:
        # exact case id or model id; a trailing * matches a prefix (loading the wrong model swaps others out)
        pats = a.only.split(",")
        todo = [c for c in todo if any(c["id"].startswith(p[:-1]) if p.endswith("*") else p in (c["id"], c["model"])
                                       for p in pats)]
    todo.sort(key=lambda c: c["order"])
    for c in todo:   # local files only (manifests, stat calls): nothing is loaded or copied back
        c["archived"] = [x for m in [c["model"], *c.get("needs", [])] for x in archived(m)]
    if a.list:
        for c in todo:
            arch = f"  SKIP(archived): {'; '.join(c['archived'])}" if c["archived"] else ""
            print(f"{c['id']:45s} {c['kind']:7s} quick={c['quick']}{arch}")
        return 0

    code, raw, _ = post("/v1/models")
    live = {m["id"] for m in json.loads(raw)["data"]} if code == 200 else set()
    lock = Lock()
    if not a.no_lock:
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, lambda *_: (lock.release(), sys.exit(130)))
        lock.acquire()
    rows = []
    try:
        for c in todo:
            if c["archived"]:   # no request: it would make archive-restore copy the weights back
                rows.append({"id": c["id"], "status": "SKIP(archived)", "detail": "; ".join(c["archived"]),
                             "seconds": 0})
                print(f"{'SKIP(archived)':14s} {c['id']:45s}  {rows[-1]['detail']}", flush=True)
                continue
            if c["model"] not in live:
                rows.append({"id": c["id"], "status": "SKIP", "detail": "not in /v1/models", "seconds": 0})
                continue
            if not a.record and not (GOLDEN / c["id"] / "meta.json").exists():
                rows.append({"id": c["id"], "status": "SKIP", "detail": "no golden output (run --record)", "seconds": 0})
                continue
            try:
                out, code, dt, raw = run_case(c)
                warm = None
                if out is not None and c["timed"]:
                    _, code2, warm, _ = run_case(c)       # the first request may include loading the model
                    warm = warm if code2 == 200 else None
                if out is None:
                    status, detail = "FAIL", f"http {code}: {raw[:120]!r}"
                elif a.record:
                    save_golden(c, out)
                    status, detail = "RECORDED", ""
                else:
                    status, detail = compare(c, out)
                if warm is not None:
                    if a.record:
                        meta = json.loads((GOLDEN / c["id"] / "meta.json").read_text())
                        meta["warm_seconds"] = round(warm, 3)
                        (GOLDEN / c["id"] / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=1))
                    else:
                        status, detail = timing(c, warm, status, detail)
            except Exception as e:  # keep going; one broken entry must not hide the others
                status, detail, dt = "FAIL", f"{type(e).__name__}: {e}"[:160], 0
            rows.append({"id": c["id"], "status": status, "detail": detail, "seconds": round(dt, 2)})
            print(f"{status:8s} {c['id']:45s} {dt:7.1f}s  {detail}", flush=True)
    finally:
        lock.release()

    LOGS.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"  # two runs ending in the same second overwrote each other
    mode = "record" if a.record else "quick" if a.quick else "full"
    counts = {s: sum(r["status"] == s for r in rows)
              for s in ("PASS", "WARN", "FAIL", "SKIP", "SKIP(archived)", "RECORDED")}
    summary = f"regress {mode} {stamp}: " + ", ".join(f"{v} {k}" for k, v in counts.items() if v)
    ran = [r for r in rows if r["status"] != "SKIP(archived)"]
    arch = [r for r in rows if r["status"] == "SKIP(archived)"]
    text = "\n".join([summary] + [f"{r['status']:8s} {r['id']:45s} {r['seconds']:7.1f}s  {r['detail']}" for r in ran]
                     + ([f"SKIP(archived) {len(arch)} (weights archived, local copy missing or incomplete; not requested):"]
                        + [f"  {r['id']:45s} {r['detail']}" for r in arch] if arch else []))
    (LOGS / f"{stamp}-{mode}.txt").write_text(text + "\n")
    (LOGS / f"{stamp}-{mode}.json").write_text(json.dumps({"mode": mode, "summary": counts, "rows": rows}, indent=1))
    print(summary)
    return 1 if counts["FAIL"] else 0


if __name__ == "__main__":
    sys.exit(main())

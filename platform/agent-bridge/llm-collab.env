# Provider models and efforts for bridge-delegated turns. Sourced (POSIX sh, exported) by the llm-collab launcher.
# Installed as <bridge>/llm-collab.env by tools/install_agents.py; put host-only overrides in
# <bridge>/llm-collab.local.env, which the installer never touches.

# Antigravity: Orchestrator route, Neon planner xhigh + Hydrogen executor xhigh (session-only --settings, agy 1.5.14+).
AGY_MODEL='orchestrator:gemini-4-neon-xhigh+gemini-4-hydrogen-xhigh'
# Claude Code: read by the Bridge model policy (--model) and by claude -p itself (effort).
ANTHROPIC_MODEL='claude-opus-5-5'
CLAUDE_CODE_EFFORT_LEVEL='high'
# Codex: written into the delegated Codex home (<bridge>/state/codex/config.toml) on every Codex start.
BRIDGE_CODEX_MODEL='gpt-6.2-sol'
BRIDGE_CODEX_REASONING_EFFORT='medium'

#!/usr/bin/python3 -I
"""Read Flash-Next's weight files into the page cache while it is not loaded, so its next load is warm (2026-11-23).

Flash-Next (Strata, --mmap-experts) starts in ~9 s when its 56 GB expert GGUF is in the page cache and ~20 s when it
is not (reports/ops.md OPS2). Video, mammoth and minimax-h3-image-pe (its expander unloads Flash-Next) push those
pages out. Run every 15 s by the LaunchAgent com.local.flashnext-prefetch; each run is one cheap check, and only when
all of these hold does it read the missing parts of the files back (sequential reads, throttled background IO):
  - not disabled: FLASHNEXT_PREFETCH=0 in the environment (e.g. `launchctl setenv FLASHNEXT_PREFETCH 0`) or the file
    <checkout>/.local/flashnext-prefetch.off exists (persistent switch; delete it to turn prefetching back on);
  - no gpu-lock share is held or queued (a holder may be measuring speed; llama-swap is paused then anyway);
  - llama-swap answers /running and no qwen3.8-flash-next* entry is starting, loaded or stopping;
  - no bin/archive-restore / bin/model-archive transfer is running, and strata-ad427 is not being evicted (we hold its
    shared use.lock while reading, like a running server, so `model-archive archive --evict` waits for us);
  - free memory covers the bytes still missing plus a margin (FLASHNEXT_PREFETCH_MARGIN_GIB, default 12): free =
    free + speculative + purgeable pages; only when nothing besides the always-loaded embedding runs does the page
    cache of other files count too (macOS kern.memorystatus_level), since then no running model owns it.
While reading it re-checks every 1 GiB and stops when a gpu-lock share appears, the set of running llama-swap models
changes, a transfer starts, or kern.memorystatus_level falls below 25%. After a stop it waits 5 min before trying again.
Files: those the engine config names (--native GGUF, the --pack directory, --mtp directory and the mtp-q2_0.gguf
beside it, --expert-profile, the vision mmproj); the 38 GB --ple-gguf is left out (the engine only touches rows of it, so reading it would only take
memory). Log: logs/prefetch/flashnext-prefetch.log (one line per decision change and per read).

  flashnext-prefetch              one check, prefetch if allowed (what the LaunchAgent runs)
  flashnext-prefetch --status     print residency, memory and the decision; read nothing
  flashnext-prefetch --evict      drop the files from the page cache (tests only: needs no other user of the files)
  --test                          tests only: ignore gpu-lock shares (the caller holds one) and an unreachable llama-swap
Standard library only, system Python.
"""
import ctypes
import ctypes.util
import fcntl
import json
import mmap
import os
import re
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CONFIG = Path(os.environ.get("FLASHNEXT_PREFETCH_CONFIG")
              or ROOT / "services/text/strata/configs/strata-ad427-c262k-p2-compact.json")
OFF_FILE = ROOT / ".local/flashnext-prefetch.off"
LOCKS = Path(os.environ.get("GPU_LOCK_DIR") or ROOT / ".locks")
ARCHIVE_STATE = Path(os.environ.get("ARCHIVE_RESTORE_MODELS") or Path.home() / "models") / ".model-archive"
USE_LOCK_MODEL = "strata-ad427"
KEY_FILE = ROOT / "platform/llama-swap/.api_key"
LSW = os.environ.get("LLAMA_SWAP_URL", "http://127.0.0.1:8081")
LOG_DIR = ROOT / "logs/prefetch"
LOG, STATE = LOG_DIR / "flashnext-prefetch.log", LOG_DIR / "state.json"
STRATA_PREFIX = "qwen3.8-flash-next"
RESIDENT_ALWAYS = {"embeddinggemma-2"}          # preloaded, no capacities (conf.d/embedding.yaml)
GiB = 2 ** 30
MARGIN = float(os.environ.get("FLASHNEXT_PREFETCH_MARGIN_GIB", "12")) * GiB
MIN_MISSING = 512 * 2 ** 20                     # below this the cache counts as warm
CHUNK = 16 * 2 ** 20
RECHECK = GiB
MIN_LEVEL_WHILE_READING = 25
BACKOFF_S = 300

libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
libc.mmap.restype = ctypes.c_void_p
libc.mmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_longlong]
libc.munmap.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
libc.mincore.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_char_p]
libc.msync.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int]
PAGE = mmap.PAGESIZE
MAP_FAILED = ctypes.c_void_p(-1).value


def log(msg):
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%F %T ") + msg + "\n")


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(st):
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st))
    tmp.replace(STATE)


def target_files():
    cfg = json.loads(CONFIG.read_text())
    args, files = cfg.get("args", []), []

    def arg(name):
        return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None

    for name in ("--native", "--expert-profile"):
        if arg(name):
            files.append(Path(arg(name)))
    for name in ("--pack", "--mtp"):
        if arg(name) and Path(arg(name)).is_dir():
            files += sorted(p for p in Path(arg(name)).iterdir() if p.is_file())
    if arg("--mtp") and (Path(arg("--mtp")).parent / "mtp-q2_0.gguf").is_file():
        files.append(Path(arg("--mtp")).parent / "mtp-q2_0.gguf")   # the Metal engine reads it beside rt/
    mmproj = (cfg.get("vision") or {}).get("mmproj")
    if mmproj:
        files.append(Path(mmproj))
    return files


def residency(path):
    """(size, vector of 0/1 per page) of a file's pages in the page cache, via mmap + mincore (reads nothing)."""
    size = path.stat().st_size
    if size == 0:
        return 0, b""
    fd = os.open(path, os.O_RDONLY)
    try:
        addr = libc.mmap(None, size, mmap.PROT_READ, mmap.MAP_SHARED, fd, 0)
        if addr in (None, MAP_FAILED):
            raise OSError(ctypes.get_errno(), f"mmap {path}")
        try:
            npages = (size + PAGE - 1) // PAGE
            vec = ctypes.create_string_buffer(npages)
            if libc.mincore(addr, size, vec) != 0:
                raise OSError(ctypes.get_errno(), f"mincore {path}")
            return size, vec.raw[:npages].translate(bytes(1 if b & 1 else 0 for b in range(256)))
        finally:
            libc.munmap(addr, size)
    finally:
        os.close(fd)


def missing_runs(vec):
    """[(first page, page count)] of pages not in the cache."""
    return [(m.start(), m.end() - m.start()) for m in re.finditer(b"\x00+", vec)]


def survey(files):
    out = []
    for p in files:
        size, vec = residency(p)
        runs = missing_runs(vec)
        missing = min(size, sum(n for _, n in runs) * PAGE)
        out.append({"path": p, "size": size, "missing": missing, "runs": runs})
    return out


def vm():
    out = subprocess.run(["/usr/bin/vm_stat"], capture_output=True, text=True).stdout
    page = int(re.search(r"page size of (\d+)", out).group(1))
    val = {m.group(1): int(m.group(2)) * page for m in re.finditer(r"^(.+?):\s+(\d+)\.", out, re.M)}
    level = int(subprocess.run(["/usr/sbin/sysctl", "-n", "kern.memorystatus_level"],
                               capture_output=True, text=True).stdout.strip() or 0)
    total = int(subprocess.run(["/usr/sbin/sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout)
    strict = val.get("Pages free", 0) + val.get("Pages speculative", 0) + val.get("Pages purgeable", 0)
    return {"strict": strict, "level": level, "total": total}


def running():
    req = urllib.request.Request(LSW + "/running")
    try:
        req.add_header("Authorization", "Bearer " + KEY_FILE.read_text().strip())
    except OSError:
        pass
    with urllib.request.urlopen(req, timeout=5) as r:
        return sorted(f"{m.get('model')}:{m.get('state')}" for m in json.load(r).get("running") or [])


def gpu_lock_busy():
    names = [p.name for d in ("holders", "queue") if (LOCKS / d).is_dir() for p in (LOCKS / d).iterdir()
             if not p.name.startswith(".")]
    return ", ".join(sorted(names))


def transfer_busy():
    """Name of a model whose archive transfer lock is held right now (checked without waiting), else ''."""
    if not ARCHIVE_STATE.is_dir():
        return ""
    for p in ARCHIVE_STATE.glob("*.transfer.lock"):
        try:
            with open(p, "a") as f:
                fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
                fcntl.flock(f, fcntl.LOCK_UN)
        except BlockingIOError:
            return p.name[:-len(".transfer.lock")]
        except OSError:
            continue
    return ""


def throttle_io():
    """Background disk IO for this process (IOPOL_TYPE_DISK, IOPOL_SCOPE_PROCESS, IOPOL_THROTTLE)."""
    try:
        libc.setiopolicy_np(0, 0, 3)
    except AttributeError:
        pass
    try:
        os.nice(10)
    except OSError:
        pass


def gib(n):
    return f"{n / GiB:.1f} GiB"


def decide(args, files_survey=None):
    """(ok, reason, details). Cheap checks first; the residency survey only when they pass."""
    if os.environ.get("FLASHNEXT_PREFETCH", "1").strip().lower() in ("0", "off", "false", "no"):
        return False, "disabled (FLASHNEXT_PREFETCH=0)", {}
    if OFF_FILE.exists():
        return False, f"disabled ({OFF_FILE} exists)", {}
    busy = gpu_lock_busy()
    if busy and not args.test:
        return False, f"gpu-lock in use ({busy})", {}
    try:
        run = running()
    except Exception as e:  # noqa: BLE001 - llama-swap down or restarting: try again next round
        if not args.test:
            return False, f"llama-swap /running unavailable ({type(e).__name__})", {}
        run = []
    if any(r.startswith(STRATA_PREFIX) for r in run):
        return False, "Flash-Next loaded or loading", {"running": run}
    t = transfer_busy()
    if t:
        return False, f"archive transfer of {t} running", {"running": run}
    files = target_files()
    absent = [str(p) for p in files if not p.is_file()]
    if absent:
        return False, f"files missing ({', '.join(absent)})", {"running": run}
    sv = files_survey or survey(files)
    size, missing = sum(f["size"] for f in sv), sum(f["missing"] for f in sv)
    det = {"running": run, "survey": sv, "size": size, "missing": missing}
    if missing < MIN_MISSING:
        return False, f"warm ({gib(size - missing)} of {gib(size)} cached)", det
    m = vm()
    idle = all(r.split(":")[0] in RESIDENT_ALWAYS for r in run) and not busy
    avail = m["strict"]
    if idle:
        avail = max(avail, m["level"] * m["total"] // 100 - (size - missing))
    det.update(mem=m, idle=idle, avail=avail)
    if avail < missing + MARGIN:
        return False, (f"not enough free memory ({gib(avail)} free{' incl. idle cache' if idle else ''}, "
                       f"need {gib(missing)} + {gib(MARGIN)} margin)"), det
    return True, f"{gib(missing)} of {gib(size)} missing, {gib(avail)} free", det


def still_ok(args, run0):
    if gpu_lock_busy() and not args.test:
        return "gpu-lock in use"
    try:
        if running() != run0:
            return "running models changed"
    except Exception as e:  # noqa: BLE001
        if not args.test:
            return f"llama-swap /running unavailable ({type(e).__name__})"
    if transfer_busy():
        return "archive transfer started"
    if vm()["level"] < MIN_LEVEL_WHILE_READING:
        return f"memory level below {MIN_LEVEL_WHILE_READING}%"
    return ""


def prefetch(args, det):
    throttle_io()
    use = None
    if ARCHIVE_STATE.is_dir():
        use = open(ARCHIVE_STATE / f"{USE_LOCK_MODEL}.use.lock", "a")
        try:
            fcntl.flock(use, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            use.close()
            return "aborted: strata-ad427 is being archived", 0, 0.0
    buf = bytearray(CHUNK)
    done, since_check, t0, why = 0, 0, time.time(), ""
    try:
        for f in det["survey"]:
            fd = os.open(f["path"], os.O_RDONLY)
            try:
                for first, count in f["runs"]:
                    off, end = first * PAGE, min(f["size"], (first + count) * PAGE)
                    while off < end and not why:
                        n = min(CHUNK, end - off)
                        os.lseek(fd, off, os.SEEK_SET)
                        got = os.readv(fd, [memoryview(buf)[:n]])
                        if got <= 0:
                            break
                        off += got
                        done += got
                        since_check += got
                        if since_check >= RECHECK:
                            since_check = 0
                            why = still_ok(args, det["running"])
                    if why:
                        break
            finally:
                os.close(fd)
            if why:
                break
    finally:
        if use:
            use.close()
    return (f"aborted: {why}" if why else "done"), done, time.time() - t0


def evict(files):
    """Drop the files' pages from the page cache: msync(MS_INVALIDATE) on a shared read-only mapping."""
    for p in files:
        size = p.stat().st_size
        if not size:
            continue
        fd = os.open(p, os.O_RDONLY)
        try:
            addr = libc.mmap(None, size, mmap.PROT_READ, mmap.MAP_SHARED, fd, 0)
            if addr in (None, MAP_FAILED):
                raise OSError(ctypes.get_errno(), f"mmap {p}")
            try:
                if libc.msync(addr, size, 0x0002) != 0:      # MS_INVALIDATE
                    raise OSError(ctypes.get_errno(), f"msync {p}")
            finally:
                libc.munmap(addr, size)
        finally:
            os.close(fd)


def main():
    import argparse
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--evict", action="store_true")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()

    if args.evict:
        files = target_files()
        evict(files)
        for f in survey(files):
            print(f"{f['path']}: {gib(f['size'] - f['missing'])} of {gib(f['size'])} cached after evict")
        return 0

    ok, reason, det = decide(args)
    if args.status:
        for f in det.get("survey", []):
            print(f"{gib(f['size'] - f['missing']):>9} of {gib(f['size']):>9} cached  {f['path']}")
        if "mem" in det:
            m = det["mem"]
            print(f"memory: strict free {gib(m['strict'])}, memorystatus_level {m['level']}%, idle={det['idle']}, "
                  f"counted free {gib(det['avail'])}, margin {gib(MARGIN)}")
        print(("would prefetch: " if ok else "skip: ") + reason)
        return 0

    st = load_state()
    now = time.time()
    if ok and not args.test and now - st.get("aborted_at", 0) < BACKOFF_S:
        ok, reason = False, "backing off after an aborted read"
    if not ok:
        kind = reason.split(" (")[0]           # log changes of the kind of reason only (not every new holder or number)
        if st.get("last") != kind:
            log("skip: " + reason)
            st["last"] = kind
            save_state(st)
        return 0
    log("start: " + reason)
    result, done, secs = prefetch(args, det)
    after = survey([f["path"] for f in det["survey"]])
    cached, size = sum(f["size"] - f["missing"] for f in after), sum(f["size"] for f in after)
    log(f"{result}: read {gib(done)} in {secs:.1f} s ({done / GiB / max(secs, 1e-3):.2f} GiB/s); "
        f"now {gib(cached)} of {gib(size)} cached")
    st.update(last=result, finished_at=time.time())
    if result != "done":
        st["aborted_at"] = time.time()
    save_state(st)
    return 0


if __name__ == "__main__":
    sys.exit(main())
